{
  "version": "2.0.0",
  // In order for this to work. in VSCode, the shortcuts are 
  // * Ctrl + Shift + P
  // ? Type "Tasks: Manage Automatic Tasks", and then press enter
  // -> Enable "Allow Automatic Tasks"
  // or in settings.json: "task.allowAutomaticTasks": "on",
  "tasks": [
    //------------------------------//
    // Build External Libraries     //
    //------------------------------//
    {
      "label": "Pre-Build Libraries",
      "type": "shell", //  "runOptions": { "runOn": "folderOpen" },
      "command": "npx nx run-many --targets=build --projects=ReactComponents,Classes",
      // * "command": "npx nx run ReactComponents:build --output-style=tui",
      "presentation": {
        "focus": false, "reveal": "silent",
        "panel": "dedicated", "echo": false, "clear": true,
        "showReuseMessage": false,
      },
      "icon": { "id": "coffee", "color": "terminal.ansiMagenta" },
    },
    
    
    //------------------------------//
    // Serve App (Deployment)       //
    //------------------------------//
    {
      "label": "Deployment",
      "command": "npx nx run Frontend:serve --output-style=tui",
      // * "command": "npx nx run-many --targets=build,serve --projects=ReactComponents,Frontend --parallel=false",
      "type": "shell", "isBackground": true, // remove loading spinner...
      "dependsOn": "Pre-Build Libraries", "dependsOrder": "sequence", // run "Pre-Build Libraries" first
      "runOptions": { "runOn": "folderOpen" }, // This will trigger the "Pre-Build Libraries" task to run on start as well.
      "icon": { "id": "window-active", "color": "terminal.ansiBlue" },
      "presentation": {
        "focus": false, "reveal": "always",
        "panel": "dedicated", "echo": true, "clear": false,
        "showReuseMessage": false,
      },
    },
    
    
    //------------------------------//
    // Default Console Tab          //
    //------------------------------//
    {
      "label": "Console",
      "command": "powershell", 
      "type": "shell", "isBackground": true, "runOptions": {  "runOn": "folderOpen" },
      "icon": { "id": "terminal", "color": "terminal.ansiGreen" },
      "presentation": {
        "focus": true, "reveal": "always",
        "panel": "shared", "echo": true,
        "close": false,
      },
    },
  ]
}
