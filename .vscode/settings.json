{
  "cSpell.words": [
    "Addit",
    "chashu",
    "Chbx",
    "Chckbx",
    "Clrs",
    "debouncer",
    "Demandjump",
    "devlog",
    "Hashbar",
    "navigations",
    "nori",
    "NUMS",
    "quicklink",
    "quicklinks",
    "Selectedcontent",
    "slct",
    "slctd",
    "sldr",
    "SSAS",
    "subroot",
    "subtable",
    "Svgs",
    "Textareas",
    "Textastic",
    "VITE"
  ],
  // Tailwind @apply css binds
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    ".*additionalStyles.*", // Add your custom prop pattern here
    ".*styles.*", 
    ".*Styles.*" // Or another pattern
  ],

  // JsDoc specific styling
  "workbench.colorCustomizations": {
    "editorHoverWidget.background": "#1e222a",
    "editorHoverWidget.border": "#3e4451",
    "editorHoverWidget.statusBarBackground": "#21252b",
    "textBlockCodeBlock.background": "#282c34"
  },

  // Editor specific stuff for the terminal
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
  "terminal.integrated.fontSize": 14,
  "editor.fontLigatures": true,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.letterSpacing": 0.5,
  "terminal.integrated.lineHeight": 1.2,

  // Professional Cursor & Styling
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.gpuAcceleration": "on",

  // Clean up the UI
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.tabs.title": "${process}",
  // "terminal.integrated.tabs.separator": " :test: ", // Isn't working 
  "terminal.integrated.tabs.description": "${process}: ${shellPromptInput}",
  
  
  /** 
  * Tagged comment themes
  */
  "better-comments.multilineComments": true,
  "better-comments.highlightPlainText": true,
  "better-comments.tags": [
    // ! This comment's color is red -> error/fallback?
    // ? This comment's current color is blue -> condition/scenario?
    // * This comment's current color is turquoise -> special notes?
    // -> This comment's color is green -> return scenario?
    // <- This comment's color is purple -> misc comment.
    {
      "tag": "!",
      "color": "#fa3d3e", "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true
    },
    {
      "tag": "?",
      "color": "#7499ff",
      "strikethrough": false, "underline": false, "backgroundColor": "#00000033",
      "bold": false, "italic": true
    },
    {
      "tag": "*",
      "color": "#3ec2d6",
      "strikethrough": false, "underline": false, "backgroundColor": "#00000033",
      "bold": false, "italic": true
    },
    {
      "tag": "->",
      "color": "#12b362",
      "strikethrough": false, "underline": false, "backgroundColor": "#00000033",
      "bold": false, "italic": true
    },    {
      "tag": "<-",
      "color": "#a94ada", "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true
    },
  ]
}
